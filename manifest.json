{
  "manifest_version": 3,
  "name": "Instagram Unfollowers PRO - Ghost Score",
  "version": "8.6.0",
  "description": "See who doesn't follow you back. Ghost Score 0-100, PDF reports, 16 languages. 100% local - no password.",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "IG Unfollowers PRO",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "host_permissions": ["https://*.instagram.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.content.js"],
      "matches": ["https://*.instagram.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "igpro@edvincodes.com",
      "strict_min_version": "121.0"
    }
  }
}
